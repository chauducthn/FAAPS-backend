// ==========================================
// FAAPS Database Schema - DBML Format
// For dbdiagram.io ERD Generation
// 44 Tables across 11 Groups (Synchronized with Remote Backend MySQL Schema)
//
// Conventions:
// - Primary keys are UUID (generated by DB or application)
// - Scores and GPA use the 10-point scale (0.00 - 10.00), numeric only, no letter grades
// - Academic results are imported from FAP, they are not managed here
// ==========================================

// ==========================================
// GROUP 1: CORE IDENTITY & ACCESS
// ==========================================

Table roles {
  id uuid [pk, default: `(UUID())`]
  code varchar(50) [unique, not null, note: 'ADMIN, ADVISOR, STUDENT']
  name varchar(100) [not null]
  description text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table users {
  id uuid [pk, default: `(UUID())`]
  role_id uuid [not null, ref: > roles.id]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [note: 'NULL when the account only signs in through an external provider (e.g. Google)']
  auth_provider varchar(20) [default: 'LOCAL', note: 'LOCAL, GOOGLE']
  external_id varchar(255) [note: 'Provider user id (Google "sub" claim)']
  full_name varchar(255) [not null]
  phone varchar(20)
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, INACTIVE, SUSPENDED, LOCKED']
  email_verified_at timestamp
  last_login_at timestamp
  failed_login_attempts int [default: 0]
  locked_until timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (role_id, status)
    (auth_provider, external_id) [unique]
  }
}


Table refresh_tokens {
  id uuid [pk, default: `(UUID())`]
  user_id uuid [not null]
  token varchar(500) [unique, not null]
  expires_at timestamp [not null]
  revoked_at timestamp
  ip_address varchar(45)
  user_agent varchar(500)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, expires_at)
  }
}

Table password_reset_tokens {
  id uuid [pk, default: `(UUID())`]
  user_id uuid [not null]
  token varchar(255) [unique, not null]
  expires_at timestamp [not null]
  used_at timestamp
  ip_address varchar(45)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table admin_control {
  control_id tinyint [pk, default: 1, note: 'Singleton constraint: always 1']
  current_admin_id uuid [not null, ref: - users.id]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table admin_handovers {
  id uuid [pk, default: `(UUID())`]
  from_admin_id uuid [not null, ref: > users.id]
  to_admin_id uuid [not null, ref: > users.id]
  handover_date date [not null]
  notes text
  recorded_by_user_id uuid [not null, ref: > users.id]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    handover_date
    (from_admin_id, to_admin_id)
  }
}


// ==========================================
// GROUP 2: ACADEMIC STRUCTURE
// ==========================================

Table majors {
  id uuid [pk, default: `(UUID())`]
  code varchar(50) [unique, not null]
  name varchar(255) [not null]
  description text
  total_credits int [not null]
  duration_years decimal(3,1) [not null]
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, INACTIVE']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
  }
}

Table semesters {
  id uuid [pk, default: `(UUID())`]
  code varchar(50) [unique, not null, note: 'e.g. SP2026, SU2026, FA2026']
  name varchar(100) [not null]
  start_date date [not null]
  end_date date [not null]
  is_current boolean [default: false]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (start_date, end_date)
  }
}

Table curriculum_versions {
  id uuid [pk, default: `(UUID())`]
  major_id uuid [not null, ref: > majors.id]
  version varchar(50) [not null, note: 'e.g. K18, K19']
  name varchar(255) [not null]
  effective_from_semester_id uuid [not null, ref: > semesters.id]
  effective_to_semester_id uuid [ref: > semesters.id]
  description text
  is_current boolean [default: false]
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, INACTIVE']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (major_id, version) [unique]
    (major_id, is_current)
  }
}


Table course_categories {
  id uuid [pk, default: `(UUID())`]
  code varchar(50) [unique, not null]
  name varchar(100) [not null]
  description text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
}

// ==========================================
// GROUP 3: COURSES & PREREQUISITES
// ==========================================

Table courses {
  id uuid [pk, default: `(UUID())`]
  code varchar(50) [unique, not null]
  name varchar(255) [not null]
  credits int [not null]
  category_id uuid [not null, ref: > course_categories.id]
  description text
  objectives text
  learning_outcomes text
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, INACTIVE']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    category_id
  }
}

Table course_prerequisites {
  id uuid [pk, default: `(UUID())`]
  course_id uuid [not null]
  prerequisite_course_id uuid [not null]
  group_no int [not null, default: 1, note: 'For PREREQUISITE: rows with the same group_no are alternatives (OR); different groups are all required (AND). Use 1 for REPLACEMENT.']
  type varchar(20) [not null, default: 'PREREQUISITE', note: 'PREREQUISITE, REPLACEMENT']
  minimum_score decimal(4,2) [note: 'For PREREQUISITE only; NULL for REPLACEMENT. Minimum score uses the 10-point scale.']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (course_id, group_no, prerequisite_course_id) [unique]
    prerequisite_course_id
  }
}


Table curriculum_courses {
  id uuid [pk, default: `(UUID())`]
  curriculum_version_id uuid [not null]
  course_id uuid [not null, ref: > courses.id]
  semester_number int [not null, note: 'Recommended term in the curriculum']
  is_mandatory boolean [default: true]
  group_name varchar(100) [note: 'Elective group, if any']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (curriculum_version_id, course_id) [unique]
    (curriculum_version_id, semester_number)
  }
}

// ==========================================
// GROUP 4: STUDENTS & ADVISORS
// user_id is both PK and FK to users (1-1), no separate surrogate id
// ==========================================

Table students {
  user_id uuid [pk, ref: - users.id]
  student_code varchar(50) [unique, not null]
  major_id uuid [not null, ref: > majors.id]
  curriculum_version_id uuid [not null, ref: > curriculum_versions.id]
  enrollment_semester_id uuid [not null, ref: > semesters.id]
  expected_graduation_semester_id uuid [ref: > semesters.id]
  current_semester int [default: 1]
  current_gpa decimal(4,2) [default: 0.00, note: 'GPA 10-point scale (0.00 - 10.00)']
  total_credits_earned int [default: 0]
  academic_status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, PROBATION, SUSPENDED, GRADUATED, WITHDRAWN, LEAVE_OF_ABSENCE']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    major_id
    academic_status
  }
}

Table advisors {
  user_id uuid [pk, ref: - users.id]
  advisor_code varchar(50) [unique, not null]
  specialization text
  max_advisees int [default: 30]
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, INACTIVE, ON_LEAVE']
  work_days varchar(20) [note: 'Comma-separated ISO weekdays 1=Monday..7=Sunday']
  assignment_start_date date
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
  }
}

Table cohort_advisors {
  cohort_id uuid [not null, ref: > curriculum_versions.id]
  advisor_id uuid [not null, ref: > advisors.user_id]
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (cohort_id, advisor_id) [pk]
    advisor_id
  }
}



Table student_advisor_assignments {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  advisor_id uuid [not null, ref: > advisors.user_id]
  group_name varchar(100) [note: 'Optional student group handled by the advisor, e.g. cohort K19 - SE']
  assigned_date date [not null]
  assigned_at datetime [default: `CURRENT_TIMESTAMP`]
  assigned_by_user_id uuid [ref: > users.id]
  end_date date
  is_primary boolean [default: true]
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, COMPLETED, TRANSFERRED']
  notes text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (advisor_id, group_name)
    (student_id, is_primary)
  }
}

// ==========================================
// GROUP 5: ACADEMIC RECORDS (imported from FAP)
// ==========================================

Table student_course_records {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  course_id uuid [not null, ref: > courses.id]
  semester_id uuid [not null, ref: > semesters.id]
  final_score decimal(4,2) [note: 'Final score imported from FAP, 10-point scale (0.00 - 10.00). NULL while in progress']
  status varchar(20) [default: 'IN_PROGRESS', note: 'IN_PROGRESS, PASSED, FAILED, WITHDRAWN, EXEMPTED']
  attempt_number int [default: 1, note: 'Retake tracking']
  credits_earned int [default: 0]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, course_id, attempt_number) [unique]
    (student_id, semester_id)
  }
}


Table semester_summaries {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  semester_id uuid [not null, ref: > semesters.id]
  total_credits_enrolled int [default: 0]
  total_credits_earned int [default: 0]
  semester_gpa decimal(4,2) [default: 0.00, note: '10-point scale. Imported from FAP or recomputed from student_course_records']
  cumulative_gpa decimal(4,2) [default: 0.00, note: '10-point scale']
  academic_standing varchar(20) [default: 'GOOD', note: 'GOOD, PROBATION, SUSPENDED']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, semester_id) [unique]
  }
}

Table academic_warnings {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  semester_id uuid [not null, ref: > semesters.id]
  warning_type varchar(20) [not null, note: 'LOW_GPA, FAILED_COURSES, ATTENDANCE, OTHER']
  severity varchar(20) [not null, note: 'WARNING, PROBATION, FINAL_WARNING']
  description text [not null]
  action_required text
  issued_by_user_id uuid [not null, ref: > users.id]
  acknowledged_at timestamp
  resolved_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    student_id
    semester_id
  }
}


// ==========================================
// GROUP 6: STUDY PLANS
// A rejected plan is kept: the student edits it and submits a new version.
// ==========================================

Table study_plans {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  semester_id uuid [not null, ref: > semesters.id]
  version int [not null, default: 1, note: 'Increases each time the student resubmits after a review']
  is_current boolean [default: true, note: 'Only the latest version of a plan is current']
  previous_plan_id uuid [note: 'Version this one was created from']
  plan_type varchar(20) [default: 'REGULAR', note: 'REGULAR, MAKEUP, ACCELERATED, REDUCED']
  total_credits_planned int [default: 0]
  status varchar(20) [default: 'SUBMITTED', note: 'SUBMITTED, APPROVED, REJECTED, NEEDS_REVISION']
  submitted_at timestamp
  reviewed_by_user_id uuid
  reviewed_at timestamp
  review_notes text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, semester_id, version) [unique]
    (student_id, semester_id, is_current)
    status
  }
}

Table study_plan_courses {
  id uuid [pk, default: `(UUID())`]
  study_plan_id uuid [not null]
  course_id uuid [not null, ref: > courses.id]
  planned_credits int [not null]
  priority varchar(20) [default: 'MEDIUM', note: 'HIGH, MEDIUM, LOW']
  notes text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (study_plan_id, course_id) [unique]
  }
}


Table course_recommendations {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  course_id uuid [not null, ref: > courses.id]
  semester_id uuid [not null, ref: > semesters.id]
  recommendation_source varchar(20) [not null, note: 'ADVISOR, AI, CURRICULUM']
  ai_message_id uuid [note: 'Set when the recommendation comes from an AI answer']
  recommended_by_user_id uuid [note: 'Set when the source is ADVISOR']
  confidence_score decimal(5,4)
  reasoning text
  priority varchar(20) [default: 'MEDIUM', note: 'HIGH, MEDIUM, LOW']
  status varchar(20) [default: 'PENDING', note: 'PENDING, ACCEPTED, REJECTED']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, semester_id)
    (recommendation_source, status)
  }
}

// ==========================================
// GROUP 7: ACADEMIC RULES
// ==========================================

Table academic_policies {
  id uuid [pk, default: `(UUID())`]
  curriculum_version_id uuid [not null]
  policy_type varchar(30) [not null, note: 'ADVANCED_STUDY, RETAKE, MAX_CREDITS_PER_SEMESTER, MIN_CREDITS_PER_SEMESTER, COURSE_REPEAT_LIMIT, GPA_WARNING, ACADEMIC_PROBATION, OTHER']
  condition_expression text [note: 'JSON, e.g. {"min_gpa": 5.0, "min_credits": 30}']
  restriction_expression text [note: 'JSON, restrictions when the policy applies']
  approval_required boolean [default: false]
  priority int [default: 0]
  description text
  display_message text [note: 'Message shown to the student']
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (curriculum_version_id, policy_type)
  }
}


// Requirements are defined once here. Per-student progress lives in student_requirement_status,
// so graduation_checks does not copy required values and cannot drift from the requirements.
Table graduation_requirements {
  id uuid [pk, default: `(UUID())`]
  curriculum_version_id uuid [not null]
  requirement_type varchar(20) [not null, note: 'TOTAL_CREDITS, CATEGORY_CREDITS, MINIMUM_GPA, SPECIFIC_COURSE, OTHER']
  description text [not null]
  min_credits int [note: 'TOTAL_CREDITS, CATEGORY_CREDITS']
  min_gpa decimal(4,2) [note: 'MINIMUM_GPA, 10-point scale']
  category_id uuid [ref: > course_categories.id, note: 'CATEGORY_CREDITS']
  course_id uuid [ref: > courses.id, note: 'SPECIFIC_COURSE']
  is_mandatory boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (curriculum_version_id, requirement_type)
  }
}

Table student_requirement_status {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null]
  requirement_id uuid [not null]
  status varchar(20) [default: 'NOT_STARTED', note: 'NOT_STARTED, IN_PROGRESS, SATISFIED, NOT_SATISFIED']
  progress_value decimal(6,2) [note: 'Credits earned or GPA reached for this requirement']
  checked_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, requirement_id) [unique]
    status
  }
}

Table graduation_checks {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  curriculum_version_id uuid [not null, ref: > curriculum_versions.id]
  check_date timestamp [default: `CURRENT_TIMESTAMP`]
  total_credits_earned int [default: 0]
  current_gpa decimal(4,2) [default: 0.00, note: '10-point scale']
  is_eligible boolean [default: false]
  checked_by_user_id uuid
  notes text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, check_date)
  }
}


// ==========================================
// GROUP 8: ADVISING
// ==========================================

Table advising_requests {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  advisor_id uuid [note: 'NULL until an advisor takes the request']
  study_plan_id uuid [note: 'Optional: the plan the request is about']
  request_type varchar(30) [not null, note: 'PLAN_REVIEW, COURSE_SELECTION, ACADEMIC_GUIDANCE, GRADUATION_CHECK, OTHER']
  title varchar(255) [not null]
  description text
  status varchar(20) [default: 'PENDING', note: 'PENDING, IN_PROGRESS, RESOLVED, CANCELLED']
  resolved_at timestamp
  resolution_summary text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, status)
    (advisor_id, status)
  }
}

Table advising_messages {
  id uuid [pk, default: `(UUID())`]
  advising_request_id uuid [not null]
  sender_user_id uuid [not null, ref: > users.id]
  content text [not null]
  is_internal boolean [default: false, note: 'Advisor-only note, hidden from the student']
  read_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (advising_request_id, created_at)
  }
}


Table advising_sessions {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id]
  advisor_id uuid [not null, ref: > advisors.user_id]
  advising_request_id uuid [note: 'Optional: appointment created from a request']
  session_type varchar(20) [default: 'SCHEDULED', note: 'SCHEDULED, WALK_IN, VIRTUAL']
  scheduled_at timestamp
  started_at timestamp
  ended_at timestamp
  location varchar(255)
  meeting_link varchar(500)
  agenda text
  summary text
  status varchar(20) [default: 'SCHEDULED', note: 'SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, scheduled_at)
    (advisor_id, scheduled_at)
  }
}

Table advising_notes {
  id uuid [pk, default: `(UUID())`]
  student_id uuid [not null, ref: > students.user_id, note: 'A note belongs to the student, with or without a session']
  advising_session_id uuid [note: 'NULL for notes written outside a session']
  note_type varchar(20) [default: 'GENERAL', note: 'GENERAL, ACADEMIC, PERSONAL, ACTION_ITEM, FOLLOW_UP']
  content text [not null]
  is_private boolean [default: false]
  action_required boolean [default: false]
  due_date date
  created_by_user_id uuid [not null, ref: > users.id]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (student_id, created_at)
    advising_session_id
    (action_required, due_date)
  }
}


Table advisor_availability {
  id uuid [pk, default: `(UUID())`]
  advisor_id uuid [not null]
  day_of_week varchar(20) [not null, note: 'MONDAY ... SUNDAY']
  start_time time [not null]
  end_time time [not null]
  location varchar(255)
  is_virtual boolean [default: false]
  max_appointments int [default: 1]
  is_active boolean [default: true]
  effective_from date
  effective_to date
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (advisor_id, day_of_week)
  }
}

// ==========================================
// GROUP 9: KNOWLEDGE BASE (RAG)
// Regulations, handbooks and curriculum documents the AI retrieves from
// ==========================================

Table knowledge_documents {
  id uuid [pk, default: `(UUID())`]
  title varchar(255) [not null]
  doc_type varchar(20) [not null, note: 'REGULATION, HANDBOOK, CURRICULUM, POLICY, OTHER']
  description text
  file_path varchar(500) [not null]
  file_size int
  mime_type varchar(100)
  language varchar(10) [default: 'vi']
  version int [not null, default: 1, note: 'New upload = new row with higher version, old versions stay readable']
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, INACTIVE. Only ACTIVE documents are retrieved']
  effective_date date
  ocr_used boolean [default: false, note: 'Text extracted through the OCR API']
  processing_status varchar(20) [default: 'PENDING', note: 'PENDING, PROCESSED, FAILED']
  indexed_at timestamp
  uploaded_by_user_id uuid [not null, ref: > users.id]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (title, version) [unique]
    (doc_type, status)
  }
}


Table document_chunks {
  id uuid [pk, default: `(UUID())`]
  knowledge_document_id uuid [not null]
  chunk_no int [not null]
  content text [not null]
  page_number int
  section_title varchar(255)
  token_count int
  embedding json [note: 'Vector from the embedding API. Use a vector column or an external vector DB if available']
  embedding_model varchar(100)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (knowledge_document_id, chunk_no) [unique]
  }
}

// ==========================================
// GROUP 10: AI INTEGRATION
// The system calls an existing AI API (Gemini), nothing is trained here.
// API keys stay in server environment/secret storage, never in the DB.
// ==========================================

Table ai_configurations {
  id uuid [pk, default: `(UUID())`]
  name varchar(100) [unique, not null]
  provider varchar(20) [not null, note: 'GEMINI, OTHER']
  model_name varchar(100) [not null]
  purpose varchar(20) [not null, note: 'CHAT, EMBEDDING, OCR']
  temperature decimal(3,2) [default: 0.70]
  max_tokens int [default: 2048]
  retrieval_top_k int [default: 5]
  similarity_threshold decimal(5,4) [note: 'Chunks below this relevance are ignored']
  timeout_seconds int [default: 30]
  daily_request_limit int [note: 'Per-user quota']
  system_prompt text
  fallback_message text [note: 'Shown when the AI API fails or times out']
  is_active boolean [default: true]
  updated_by_user_id uuid
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (purpose, is_active)
  }
}


Table ai_conversations {
  id uuid [pk, default: `(UUID())`]
  user_id uuid [not null, ref: > users.id]
  title varchar(255)
  status varchar(20) [default: 'ACTIVE', note: 'ACTIVE, CLOSED']
  last_message_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, last_message_at)
  }
}

Table ai_messages {
  id uuid [pk, default: `(UUID())`]
  conversation_id uuid [not null]
  sender varchar(20) [not null, note: 'USER, ASSISTANT']
  content text [not null]
  question_category varchar(30) [note: 'POLICY, COURSE_INFO, STUDY_PLAN, GRADUATION, UNSUPPORTED, OTHER']
  is_unsupported boolean [default: false, note: 'Question outside the supported scope']
  is_fallback boolean [default: false, note: 'Fallback message returned because the AI call failed']
  confidence_score decimal(5,4) [note: 'Answer confidence, ASSISTANT messages only']
  ai_configuration_id uuid
  was_helpful boolean
  feedback text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (conversation_id, created_at)
    is_unsupported
  }
}

Table ai_message_sources {
  id uuid [pk, default: `(UUID())`]
  message_id uuid [not null]
  chunk_id uuid [not null, ref: > document_chunks.id]
  relevance_score decimal(5,4) [note: 'Similarity / confidence for this source']
  quoted_text text
  rank_position int
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    message_id
    chunk_id
  }
}


Table ai_usage_logs {
  id uuid [pk, default: `(UUID())`]
  user_id uuid
  message_id uuid
  ai_configuration_id uuid
  feature varchar(20) [not null, note: 'CHAT, EMBEDDING, OCR, RECOMMENDATION, SUMMARIZATION']
  prompt_tokens int [default: 0]
  completion_tokens int [default: 0]
  total_tokens int [default: 0]
  latency_ms int
  status varchar(20) [default: 'SUCCESS', note: 'SUCCESS, TIMEOUT, ERROR, RATE_LIMITED, FALLBACK']
  error_message text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id, created_at)
    (feature, status)
  }
}

Table ai_response_reports {
  id uuid [pk, default: `(UUID())`]
  conversation_id uuid [not null, ref: > ai_conversations.id]
  student_id uuid [not null, ref: > users.id]
  reason varchar(100) [not null, note: 'INCORRECT_PREREQUISITE, WRONG_POLICY, HALLUCINATION, OTHER']
  student_note text
  status varchar(20) [default: 'PENDING', note: 'PENDING, RESOLVED, REJECTED']
  resolution_note text
  resolved_by uuid [ref: > users.id]
  resolved_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (status, created_at)
    student_id
  }
}

Table ai_reported_messages {
  id uuid [pk, default: `(UUID())`]
  report_id uuid [not null, ref: > ai_response_reports.id]
  message_id uuid [not null, ref: > ai_messages.id]
  student_note text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (report_id, message_id) [unique]
  }
}


// ==========================================
// GROUP 11: SYSTEM
// ==========================================

Table notifications {
  id uuid [pk, default: `(UUID())`]
  recipient_user_id uuid [not null, ref: > users.id]
  notification_type varchar(20) [default: 'INFO', note: 'INFO, WARNING, REMINDER, PLAN_STATUS, MESSAGE, ADVISOR_REQUEST']
  title varchar(255) [not null]
  message text [not null]
  action_url varchar(500)
  related_student_id uuid [ref: > students.user_id]
  resolved_at timestamp
  is_read boolean [default: false]
  read_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (recipient_user_id, is_read)
    (related_student_id, notification_type, resolved_at)
  }
}

Table audit_logs {
  id uuid [pk, default: `(UUID())`]
  user_id uuid
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid
  old_values json
  new_values json
  ip_address varchar(45)
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (entity_type, entity_id)
    (user_id, created_at)
  }
}


Table error_logs {
  id uuid [pk, default: `(UUID())`]
  error_type varchar(100) [not null]
  error_message text [not null]
  stack_trace text
  user_id uuid
  request_url varchar(500)
  request_method varchar(10)
  severity varchar(20) [default: 'MEDIUM', note: 'LOW, MEDIUM, HIGH, CRITICAL']
  is_resolved boolean [default: false]
  resolved_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    (severity, is_resolved)
    created_at
  }
}

// ==========================================
// SUMMARY
// ==========================================
// Total: 44 Tables across 11 Groups
//
// Group 1: Core Identity & Access (6 tables)
// Group 2: Academic Structure (4 tables)
// Group 3: Courses & Prerequisites (3 tables)
// Group 4: Students & Advisors (4 tables)
// Group 5: Academic Records (3 tables)
// Group 6: Study Plans (3 tables)
// Group 7: Academic Rules (4 tables)
// Group 8: Advising (5 tables)
// Group 9: Knowledge Base (RAG) (2 tables)
// Group 10: AI Integration (7 tables)
// ==========================================
// FOREIGN KEY DELETE RULES
// Column-level refs above define the relationships; these Refs add ON DELETE behaviour.
// ==========================================

Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: course_prerequisites.course_id > courses.id [delete: cascade]
Ref: course_prerequisites.prerequisite_course_id > courses.id [delete: cascade]
Ref: curriculum_courses.curriculum_version_id > curriculum_versions.id [delete: cascade]
Ref: study_plans.previous_plan_id > study_plans.id [delete: set null]
Ref: study_plans.reviewed_by_user_id > users.id [delete: set null]
Ref: study_plan_courses.study_plan_id > study_plans.id [delete: cascade]
Ref: course_recommendations.ai_message_id > ai_messages.id [delete: set null]
Ref: course_recommendations.recommended_by_user_id > users.id [delete: set null]
Ref: academic_policies.curriculum_version_id > curriculum_versions.id [delete: cascade]
Ref: graduation_requirements.curriculum_version_id > curriculum_versions.id [delete: cascade]
Ref: student_requirement_status.student_id > students.user_id [delete: cascade]
Ref: student_requirement_status.requirement_id > graduation_requirements.id [delete: cascade]
Ref: graduation_checks.checked_by_user_id > users.id [delete: set null]
Ref: advising_requests.advisor_id > advisors.user_id [delete: set null]
Ref: advising_requests.study_plan_id > study_plans.id [delete: set null]
Ref: advising_messages.advising_request_id > advising_requests.id [delete: cascade]
Ref: advising_sessions.advising_request_id > advising_requests.id [delete: set null]
Ref: advising_notes.advising_session_id > advising_sessions.id [delete: set null]
Ref: advisor_availability.advisor_id > advisors.user_id [delete: cascade]
Ref: document_chunks.knowledge_document_id > knowledge_documents.id [delete: cascade]
Ref: ai_configurations.updated_by_user_id > users.id [delete: set null]
Ref: ai_messages.conversation_id > ai_conversations.id [delete: cascade]
Ref: ai_messages.ai_configuration_id > ai_configurations.id [delete: set null]
Ref: ai_message_sources.message_id > ai_messages.id [delete: cascade]
Ref: ai_usage_logs.user_id > users.id [delete: set null]
Ref: ai_usage_logs.message_id > ai_messages.id [delete: set null]
Ref: ai_usage_logs.ai_configuration_id > ai_configurations.id [delete: set null]
Ref: notifications.recipient_user_id > users.id [delete: cascade]
Ref: audit_logs.user_id > users.id [delete: set null]
Ref: error_logs.user_id > users.id [delete: set null]
Ref: cohort_advisors.cohort_id > curriculum_versions.id [delete: cascade]
Ref: cohort_advisors.advisor_id > advisors.user_id [delete: cascade]
Ref: admin_control.current_admin_id - users.id
Ref: admin_handovers.from_admin_id > users.id
Ref: admin_handovers.to_admin_id > users.id
Ref: admin_handovers.recorded_by_user_id > users.id
Ref: ai_response_reports.conversation_id > ai_conversations.id [delete: cascade]
Ref: ai_response_reports.student_id > users.id
Ref: ai_response_reports.resolved_by > users.id [delete: set null]
Ref: ai_reported_messages.report_id > ai_response_reports.id [delete: cascade]
Ref: ai_reported_messages.message_id > ai_messages.id [delete: cascade]
Ref: notifications.related_student_id > students.user_id [delete: set null]
Ref: student_advisor_assignments.assigned_by_user_id > users.id [delete: set null]
